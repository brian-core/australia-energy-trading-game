# Supabase (optional — enables sign-up, cloud saves, leaderboard, and the
# macro data store). Without these the game runs fine with browser-local saves
# and the BUILD finance card falls back to reference WACC/inflation.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key — SERVER ONLY, never exposed to the browser. Required by the
# macro ingestion route (/api/energy/macro/ingest) to write macro_ingest /
# macro_observations, and by the game's cloud-save/leaderboard routes
# (/api/game/save, /api/game/leaderboard), which validate a submitted game
# state server-side before writing with this key. Set in Vercel (and locally)
# to enable ingestion and cloud save/leaderboard.
SUPABASE_SERVICE_ROLE_KEY=

# OpenElectricity API key — powers live generation, WA price, the LAB 7-day
# series and price history (https://platform.openelectricity.org.au).
# Without it those feeds fall back to anonymous (heavily rate-limited) access
# and then to the demo snapshot. AEMO (east-coast price/demand) needs no key.
OPENELECTRICITY_API_KEY=
# Optional: override the API base URL (defaults to the v4 production endpoint).
# OPENELECTRICITY_API_URL=https://api.openelectricity.org.au/v4

# Anthropic API key — powers the AI desk analyst chat on /desk
# (https://platform.claude.com). SERVER ONLY. Without it the chat shows a
# friendly "not configured" message and the rest of the desk works normally.
ANTHROPIC_API_KEY=
